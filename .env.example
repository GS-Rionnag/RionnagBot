# Required: create a bot in the Discord Developer Portal and keep this secret.
DISCORD_TOKEN=

# Set this to a development server ID for fast guild-scoped command sync.
GUILD_ID=0

# Optional onboarding behavior.
ONBOARDING_DB_PATH=onboarding.sqlite3
MANAGER_ROLE_NAME=Recruitment Manager
VISITOR_ROLE_NAME=Visitor
GAMES=Marvel Rivals

# Optional custom button emoji. Leave ID at 0 to use text-only buttons.
MARVEL_EMOJI_ID=0
MARVEL_EMOJI_NAME=MR
